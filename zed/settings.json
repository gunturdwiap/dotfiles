// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "helix_mode": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "mode": "subtle",
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 2000,
    },
  },
  "vim_mode": false,
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night",
  },
  "which_key": { "enabled": true, "delay_ms": 0 },
  "lsp": {
    "pyrefly": {
      "command": "pyrefly",
      "args": ["lsp"],
    },
    "ruff": {
      "command": "ruff",
      "args": ["server"],
    },
    "typescript-language-server": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "initialization_options": {
        "plugins": [
          {
            "name": "@vue/typescript-plugin",
            "location": "/home/gunturdwiap/.local/share/nvim/mason/packages/vue-language-server/node_modules/@vue/typescript-plugin",
          },
          {
            "name": "@astrojs/ts-plugin",
            "location": "/home/gunturdwiap/.local/share/nvim/mason/packages/astro-language-server/node_modules/@astrojs/ts-plugin",
          },
        ],
      },
    },
    "sqls": {
      "command": "sqls",
      "args": ["--config", "/home/gunturdwiap/.config/sqls/config.yml"],
      "initialization_options": {
        "provideFormatter": true,
      },
    },
  },
  "languages": {
    "Go": {
      "formatter": {
        "external": {
          "command": "goimports",
        },
      },
    },
    "Python": {
      "language_servers": ["pyrefly", "ruff"],
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--parser", "typescript"],
        },
      },
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--parser", "babel"],
        },
      },
    },
    "JSON": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--parser", "json"],
        },
      },
    },
    "Vue": {
      "language_servers": ["typescript-language-server"],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--parser", "vue"],
        },
      },
    },
    "Astro": {
      "language_servers": ["typescript-language-server"],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--plugin",
            "prettier-plugin-astro",
            "--parser",
            "astro",
          ],
        },
      },
    },
    "SQL": {
      "language_servers": ["sqls"],
      "formatter": {
        "external": {
          "command": "sql-formatter",
          "arguments": ["--language", "postgresql"],
        },
      },
    },
  },
}
